# Load required libraries
library(tidyverse)
library(splines)
# 1. Create a numeric age index (1 to 18) corresponding to the 18 age groups (0-4 to 85-89)
merged_data$age_index <- as.integer(
factor(
merged_data$agegroup,
levels = paste(seq(0, 85, 5), seq(4, 89, 5), sep = "-"),
labels = 1:18
)
)
# 2. Fit Candidate Model 1: Linear main effects (baseline model)
m_linear <- glm(
n_cases ~ year + age_index + sex + offset(log(n_pop)),
family = poisson(),
data = merged_data
)
# 3. Fit Candidate Model 2: Add natural cubic splines for non-linear effects of year and age
m_spline_main <- glm(
n_cases ~ ns(year, df = 4) + ns(age_index, df = 4) + sex + offset(log(n_pop)),
family = poisson(),
data = merged_data
)
# 4. Fit Candidate Model 3 (Final Model): Include Year x Age and Year x Sex interactions, excluding Age x Sex
m2 <- glm(
n_cases ~ ns(year, df = 4) * (ns(age_index, df = 4) + sex) + offset(log(n_pop)),
family = poisson(),
data = merged_data
)
# 5. Compare model fits using AIC to justify selecting the final model (m2)
AIC(m_linear, m_spline_main, m2)
# 6. View the summary of the final model
summary(m2)
# 7. Compare models using an Analysis of Deviance (Likelihood Ratio Test)
anova(m_linear, m_spline_main, m2, test = "Chisq")
# 6. View the summary of the final model
summary(m2)
# Load required libraries
library(tidyverse)
# 1. Create a numeric age index (1 to 18) corresponding to the 18 age groups (0-4 to 85-89)
merged_data$age_index <- as.integer(
factor(
